{
  "schema_version": "synaboot.commercial-indicators-allowlist.v1",
  "purpose": "free_release_commercial_keyword_review_boundary",
  "commercial_code_included": false,
  "online_activation_required": false,
  "allowed_files": [
    ".codex/agents/architecture-agent.toml",
    ".codex/agents/git-audit-agent.toml",
    ".codex/agents/image-factory-agent.toml",
    ".codex/agents/project-decision-agent.toml",
    ".codex/agents/security-audit-agent.toml",
    ".codex/agents/webui-agent.toml",
    ".gitignore",
    "PLAN.md",
    "README.md",
    "apps/api/main.py",
    "apps/web/index.html",
    "apps/web/package-lock.json",
    "apps/web/src/main.tsx",
    "apps/web/src/types.ts",
    "config/synaboot/capabilities.free.json",
    "config/synaboot/commercial-indicators.allowlist.json",
    "config/synaboot/editions.public.json",
    "config/synaboot/public-runtime.allowlist.json",
    "docs/ADMIN_GUIDE.md",
    "docs/ADMIN_ISO_FIRST_DEPLOYMENT_PLAN.md",
    "docs/BOOT_INSTALL_ISSUES_SUMMARY.md",
    "docs/EDITION_BOUNDARY_DECISION.md",
    "docs/FREE_RELEASE_CHECKLIST.md",
    "docs/PRIVATE_COMMERCIAL_FLOW.md",
    "docs/SOFTWARE_MARKET_AND_ADMIN_ACTIONS_PLAN.md",
    "docs/SUBAGENT_SESSION_POOL.md",
    "scripts/bootstrap-synaboot.sh",
    "scripts/preflight/check-edition-boundary.sh",
    "scripts/preflight/check-private-commercial-scope.sh",
    "scripts/preflight/check-public-runtime-boundary.sh",
    "scripts/preflight/check-release-scope.sh",
    "scripts/preflight/check-software-assignment-flow.sh",
    "scripts/preflight/collect-release-evidence.sh"
  ],
  "guardrails": [
    "商业关键词只允许出现在公开说明、manifest、UI 展示、agent 规则和发布护栏中。",
    "新增命中文件必须先更新此 allowlist，并确认不包含商业实现、license 实现、支付、联网激活或混淆产物。",
    "此 allowlist 不替代 check-public-runtime-boundary.sh；公开运行时代码仍不得出现商业实现或收费层端点。"
  ]
}
